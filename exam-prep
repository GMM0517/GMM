let t1Sec=480,t2Sec=240,t1Iv=null,t2Iv=null;

function getName(){return document.getElementById('name-input').value.trim()||'考生';}
function getIntro(name){return `各位評審老師好，我叫做${name}，很高興有這個機會參加本次的口試。以下我將就抽到的題目，說明我身為領隊的處理方式，請多指教。`;}
function renderIntro(){
  const t=getIntro(getName());
  ['intro-text','script-intro-preview'].forEach(id=>{const el=document.getElementById(id);if(el)el.textContent=t;});
}
function buildSelect(){
  const sel=document.getElementById('question-select');
  sel.innerHTML='<option value="">選擇題號…</option>';
  filteredQ.forEach(q=>{const o=document.createElement('option');o.value=q.id;o.textContent=`${q.id}. ${q.cat}－${q.topic}`;sel.appendChild(o);});
}
function filterCat(){const c=document.getElementById('cat-select').value;filteredQ=c?questions.filter(q=>q.cat===c):[...questions];buildSelect();}
function showQuestion(q){
  currentQ=q;answerVisible=false;detailVisible=false;practiced.add(q.id);updateStats();
  document.getElementById('question-card').innerHTML=`<div class="badge badge-gray">題號 ${q.id}｜${q.cat}－${q.topic}</div><div class="q-text">${q.q}</div>`;
  document.getElementById('answer-sections').style.display='none';
  document.getElementById('detail-card').style.display='none';
  document.getElementById('btn-answer').textContent='顯示口試腳本';
  document.getElementById('btn-detail').style.display='none';
  document.getElementById('action-row').style.display='flex';
  resetTimer(1);resetTimer(2);
}
function updateStats(){const d=practiced.size;document.getElementById('stat-done').textContent=d;document.getElementById('stat-remain').textContent=40-d;document.getElementById('progress-fill').style.width=Math.round(d/40*100)+'%';}
function onSelectChange(){const v=document.getElementById('question-select').value;if(!v)return;const q=questions.find(x=>x.id==v);if(q)showQuestion(q);}
function drawRandom(){const pool=filteredQ.filter(q=>!practiced.has(q.id));const src=pool.length>0?pool:filteredQ;const q=src[Math.floor(Math.random()*src.length)];document.getElementById('question-select').value=q.id;showQuestion(q);}
function toggleAnswer(){
  if(!currentQ)return;answerVisible=!answerVisible;
  const sec=document.getElementById('answer-sections'),btn=document.getElementById('btn-answer');
  if(answerVisible){sec.style.display='block';document.getElementById('intro-text').textContent=getIntro(getName());document.getElementById('topic-text').textContent=currentQ.q;document.getElementById('answer-text').textContent=currentQ.a;btn.textContent='隱藏腳本';document.getElementById('btn-detail').style.display='block';}
  else{sec.style.display='none';btn.textContent='顯示口試腳本';document.getElementById('btn-detail').style.display='none';document.getElementById('detail-card').style.display='none';detailVisible=false;}
}
function toggleDetail(){
  if(!currentQ)return;detailVisible=!detailVisible;
  const card=document.getElementById('detail-card'),btn=document.getElementById('btn-detail');
  if(detailVisible){card.style.display='block';document.getElementById('detail-steps').innerHTML=currentQ.steps.map((s,i)=>`<div class="step-item"><div class="step-num">${i+1}</div><div>${s}</div></div>`).join('');btn.textContent='收起步驟';}
  else{card.style.display='none';btn.textContent='詳細步驟';}
}
function nextQuestion(){if(!currentQ){drawRandom();return;}const idx=filteredQ.findIndex(q=>q.id===currentQ.id);const next=filteredQ[(idx+1)%filteredQ.length];document.getElementById('question-select').value=next.id;showQuestion(next);}
function updateTimerDisplay(n){const s=n===1?t1Sec:t2Sec,m=Math.floor(s/60),r=s%60,el=document.getElementById(`t${n}-display`);el.textContent=`${m}:${r.toString().padStart(2,'0')}`;el.className='t-count'+(s<=30?' danger':s<=60?' warn':'');}
function toggleTimer(n){
  const iv=n===1?t1Iv:t2Iv;
  if(iv){clearInterval(iv);if(n===1)t1Iv=null;else t2Iv=null;document.getElementById(`t${n}-btn`).textContent='繼續';}
  else{document.getElementById(`t${n}-btn`).textContent='暫停';const i=setInterval(()=>{if(n===1){if(t1Sec<=0){clearInterval(t1Iv);t1Iv=null;document.getElementById('t1-btn').textContent='開始';return;}t1Sec--;}else{if(t2Sec<=0){clearInterval(t2Iv);t2Iv=null;document.getElementById('t2-btn').textContent='開始';return;}t2Sec--;}updateTimerDisplay(n);},1000);if(n===1)t1Iv=i;else t2Iv=i;}
}
function resetTimer(n){if(n===1){clearInterval(t1Iv);t1Iv=null;t1Sec=480;document.getElementById('t1-btn').textContent='開始';}else{clearInterval(t2Iv);t2Iv=null;t2Sec=240;document.getElementById('t2-btn').textContent='開始';}updateTimerDisplay(n);}
function syncName(from){const v=document.getElementById(from===2?'name-input2':'name-input').value;document.getElementById('name-input').value=v;document.getElementById('name-input2').value=v;renderIntro();}
function switchTab(tab){['practice','script','info'].forEach(t=>document.getElementById(`tab-${t}`).style.display=t===tab?'':'none');document.querySelectorAll('.tab').forEach((el,i)=>el.classList.toggle('active',['practice','script','info'][i]===tab));if(tab==='script')renderIntro();}

buildSelect();updateTimerDisplay(1);updateTimerDisplay(2);renderIntro();
</script>
</body>
</html>
