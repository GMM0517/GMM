h1.page-title { font-size: 15px; font-weight: 600; text-align: center; color: var(--text-secondary); margin-bottom: 0.75rem; }

/* Tabs */
.tab-row { display: flex; gap: 4px; margin-bottom: 0.75rem; }
.tab { flex: 1; height: 34px; border: 0.5px solid var(--border); border-radius: var(--radius); background: transparent; font-size: 12px; color: var(--text-secondary); cursor: pointer; }
.tab.active { background: var(--surface1); color: var(--text-primary); font-weight: 600; border-color: var(--border-strong); box-shadow: 0 1px 4px rgba(0,0,0,0.08); }

/* Inputs */
select, input[type=text] { height: 36px; border: 0.5px solid var(--border-strong); border-radius: var(--radius); background: var(--surface1); color: var(--text-primary); font-size: 13px; padding: 0 10px; width: 100%; }
