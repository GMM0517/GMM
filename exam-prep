.select-row select { flex: 1; }
.name-row { display: flex; gap: 8px; align-items: center; margin-bottom: 0.6rem; }
.name-row label { font-size: 12px; color: var(--text-muted); white-space: nowrap; }
.name-row input { flex: 1; }

/* Buttons */
.btn { height: 36px; padding: 0 14px; border: 0.5px solid var(--border-strong); border-radius: var(--radius); background: var(--surface1); color: var(--text-primary); font-size: 13px; cursor: pointer; white-space: nowrap; }
.btn:hover { background: var(--surface2); }
.btn-accent { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
.btn-accent:hover { background: var(--accent-hover); }
.btn-sm { height: 28px; padding: 0 10px; font-size: 11px; }
.action-row { display: flex; gap: 6px; margin-bottom: 0.6rem; }
.action-row .btn { flex: 1; font-size: 12px; }

/* Stats */
.stats { display: flex; gap: 6px; margin-bottom: 0.6rem; }
.stat { flex: 1; background: var(--surface1); border-radius: var(--radius); padding: 8px 4px; text-align: center; border: 0.5px solid var(--border); }
.stat-n { font-size: 20px; font-weight: 600; }
.stat-l { font-size: 10px; color: var(--text-muted); }
.progress-bar { height: 4px; background: var(--surface2); border-radius: 2px; margin-bottom: 0.6rem; overflow: hidden; }
.progress-fill { height: 100%; background: var(--accent); border-radius: 2px; transition: width 0.3s; }

/* Timers */
.timers { display: flex; gap: 8px; margin-bottom: 0.6rem; }
.timer-block { flex: 1; background: var(--surface1); border: 0.5px solid var(--border); border-radius: 10px; padding: 0.6rem 0.75rem; }
.t-label { font-size: 10px; color: var(--text-muted); margin-bottom: 2px; }
.t-count { font-size: 22px; font-weight: 700; color: var(--text-primary); }
.t-count.warn { color: var(--warn); }
.t-count.danger { color: var(--danger); }
.t-btns { display: flex; gap: 4px; margin-top: 4px; }
.t-btns .btn { flex: 1; height: 26px; font-size: 11px; }

/* Cards */
.card { border-radius: 12px; padding: 0.9rem 1rem; margin-bottom: 0.6rem; }
.card-q { background: var(--surface1); border: 0.5px solid var(--border); }
.card-intro { background: var(--surface2); border: 0.5px solid var(--border); }
.card-topic { background: var(--info-bg); border: 0.5px solid var(--info-border); }
.card-ans { background: var(--success-bg); border: 0.5px solid var(--success-border); }
.card-detail { background: var(--surface1); border: 0.5px solid var(--border); }
.badge { display: inline-block; font-size: 10px; font-weight: 600; border-radius: 4px; padding: 2px 8px; margin-bottom: 6px; }
.badge-gray { background: var(--surface2); color: var(--text-muted); border: 0.5px solid var(--border); }
.badge-blue { background: var(--info-bg); color: var(--info-text); }
.badge-green { background: #dcfce7; color: var(--success-text); }
.badge-orange { background: #fff7ed; color: #c2410c; }
.q-text { font-size: 14px; font-weight: 500; line-height: 1.65; }
.body-text { font-size: 13px; line-height: 1.75; color: var(--text-primary); }
.placeholder { font-size: 13px; color: var(--text-muted); display: flex; align-items: center; justify-content: center; min-height: 70px; }
.step-item { display: flex; gap: 8px; margin-bottom: 9px; font-size: 13px; line-height: 1.6; }
.step-num { flex-shrink: 0; width: 20px; height: 20px; border-radius: 50%; background: var(--accent); color: #fff; font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center; margin-top: 2px; }

/* Info */
.info-block { background: var(--surface1); border-radius: var(--radius); padding: 0.75rem 1rem; margin-bottom: 0.6rem; font-size: 12px; color: var(--text-secondary); line-height: 1.8; border-left: 3px solid var(--accent); }
.info-block b { color: var(--text-primary); }

/* Header card */
.header-card { background: var(--surface1); border: 0.5px solid var(--border); border-radius: 12px; padding: 1rem; margin-bottom: 0.75rem; }
.header-card h2 { font-size: 13px; font-weight: 600; line-height: 1.5; margin-bottom: 6px; }
.meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 6px; }
.meta-item { font-size: 11px; color: var(--text-muted); line-height: 1.6; }
.meta-item span { color: var(--text-secondary); font-weight: 600; display: block; }
</style>
</head>
